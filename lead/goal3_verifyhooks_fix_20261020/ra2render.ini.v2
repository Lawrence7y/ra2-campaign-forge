; ============================================================================
; ra2render.ini —— 【G3-SPLIT 优化包默认配置】（补丁副本 2026-10-19，执行者适用）
; 项目规则：玩法改动要独立配置、不混进默认优化配置、默认保持原版行为。
; 本文件只保留**不改变原版行为**的优化项；全部玩法键迁入文末 [Gameplay] 节
; （出厂全注释 = 全关 = 原版行为）。DLL 读取顺序：①[Gameplay] 现行节 →
; ②旧节 [Logic]/[FogOfWar] 只读迁移回退（升级老用户开启态保留）→ ③原版默认全关。
; ★本 DLL 绝不写回本文件；拆分设计详见同目录 RECEIPT.md（键位迁移映射表）。
; ============================================================================

[Render]
; 启用 SSE2 向量化软件 Blit 批处理加速（跳过透明块，大幅提升复杂场面渲染吞吐量）
EnableSIMD=1
;
; ══ 【VXL-PRE】VXL 缓存预热扩容（ZC-VXL-PRE / landing_pack_vxl_prewarm.md，L-VXL-1；默认 0）══
; EnableVxlCachePrewarm = 0 | 1（默认 0）
;   1 = init 时把 SomeVoxelCache Miss 插入路径首次分配粒度 mov ebx,0xA→mov ebx,0x40
;       （@0x00706D78 的 5B「BB 0A 00 00 00」内 imm8 一字节 0x0A→0x40；首次容量 10→64 条
;       ≈ 32 朝向 × 2 帧），少扩容、少 qsort。
;       · 只改 imm8 一字节；扩容步长（@0x706D7F mov ebx,eax 翻倍）、拷贝/插入/IsSorted
;         置脏、LastFoundEntry 清空、DisableVoxelCache 门（@0x70680E）全部不动。
;       · 守卫窗：@0x706D76(75 07) / @0x706D7D(EB 0A) / @0x706D7F(8B D8) 任一不符 ⇒ 拒装。
;       · 已是 BB 40… ⇒ 本进程已装（幂等）或外部安装者（停手不写不还原）。
;   0 = 不碰 .text（默认，零行为变化）。
;   ★ 安装态 init 决定，改键须重启；联机可装（D-VXL13：纯表现层缓存粒度，不进 .SAV/同步契约；
;     全端同键同档，禁一端 1 一端 0 以便遥测同口径）。
;   ★ 本卡无任何百分比收益承诺；热路径计数器（FindCalls/FindHits/QsortCalls/Growths/Inserts）
;     未实现（另卡）⇒ 只能验收「字节装上 + 无 except + 安装态可见」。
EnableVxlCachePrewarm=0

[Logic]
; 【G3-SPLIT】原 [Logic] 节的 TargetScanInterval / TargetScanKey 两键为玩法改动
;   （寻敌频率节流 + 分片键），已迁入文末 [Gameplay] 节；本节只留零语义变化优化键。
;
; ══ 【SW-CHARGE】充能冗余二次 call 删除（ZC-SW-CHARGE / landing_pack_sw_charge.md，L-SW-1；默认 0）══
; EnableSWChargeOpt = 0 | 1（默认 0）
;   1 = init 时把 SuperClass::HasChargeProgressed 慢路径对纯函数 GetCameoChargeState 的
;       **冗余二次 call**（@0x006CBE88 的 7B「8B CE E8 51 00 00 00」）等长替换为 90×7，
;       复用第一次结果 eax ⇒ @0x6CBE8F 写回值不变 ⇒ 零语义变化、不进帧 CRC/Checksum。
;       · 守卫窗：@0x6CBE86(74 15) / @0x6CBE8F(89 46 78) / 首次 call @0x6CBE7E(E8 5D 00 00 00)
;         任一不符 ⇒ 拒装。
;       · 禁区（一字不动）：GetCameoChargeState 公式（@0x6CBEE0）/ RechargeTimer 推进 /
;         IsCharged 翻转帧 / ChargeDrainState FSM / HasChargeProgressed 七项副作用链
;         （禁跳帧、禁按视觉帧节流）。
;       · 附录 L-SW-2（Cameo 读 +0x78 缓存）**默认不做**，未过 frame=-1 真机 Q2 前禁装。
;   0 = 不碰 .text（默认，零行为变化）。
;   ★ 安装态 init 决定，改键须重启；零语义变化 ⇒ MP 可装可保留（不强制关）。
EnableSWChargeOpt=0

[Speed]
; UnlockGameSpeed: 设为 0 彻底保护玩家的原版游戏速度控制权
; 恢复键盘加速/降速按键（-, +）以及游戏设置菜单内“游戏速度”与“屏幕滚动速度”滑块的完全灵敏响应
; 游戏在 800 单位重载下的流畅度由底层 L1 向量化渲染提供，无需暴力劫持时钟
; 【G3-SPLIT】寻敌轮询（TargetScanInterval）已属玩法键，迁入 [Gameplay]；本键默认 0 = 原版行为。
UnlockGameSpeed=0

[System]
; 启用 Low Fragmentation Heap (LFH) 低碎片堆内存分配器，杜绝粒子、子弹和音效的堆碎片与分配延迟
EnableLFH=1
; [SBH-GUARD] RC-1 堆 freelist 毒值守卫。0 = 不碰 .text（与原版逐位等价）；1 = 启用守卫（A/B 实验臂用）
EnableSbhGuard=0
; 锁定 Windows 系统时钟中断周期为 1ms，彻底消除 16ms 线程调度抖动与帧生成微卡顿
HighPrecisionTimer=1

[FogOfWar]
; 【G3-SPLIT】本节只留**不改原版行为**的修复选装/表现校准键；
;   玩法可见性键（EnableStarCraftFog / VisibilityMode / EnableSpySatRadarSweep /
;   RadarSweep* / EnableBuildingFog / EnableBulletFog / EnableUnitFog / FadeFogTransition /
;   EnableMinimapFog / RadarFogGuardMode）已迁入文末 [Gameplay] 节。
;
; ══ 【GAP-P223】裂缝保护三点表驱动（ZC-GAP-P223 合并 ZC-GAP-P21；默认 0 = 不碰 .text）══
; EnableGapProtection = 0 | 1（默认 0）
;   背景（R-GAP-PSY 静态定谳）：三个函数内层循环各含**恰好一次**「清 GapsCoveringThisCell(+0x134)」
;     store（Q4 闭合，无第 4 处）——清零使 CellClass::ReshroudCell(0x487690) 把 ShroudCounter
;     钳位到 0 ⇒ 敌方 GapGenerator 覆盖区在开图/重遮后**永久静默失能**（CreateGap/DestroyGap 不自愈）。
;   1 = init 时把三点各 6B **等长替换**为 90×6（nop），只删这一次 store，同循环其余写入原样保留：
;       P-2.1 MapClass::RevealArea2 @0x005678E0  @0x00568273 (89 99 34 01 00 00) mov [ecx+0x134], ebx
;            覆盖面：PsychicReveal 双调 @0x6CD773/0x6CD79C + 22 个 E8 caller（超武/任务脚本揭示…）
;            保留：ShroudCounter<-0(@0x0056824A) / CopyFlags|=0x10(@0x0056829A)
;       P-2.2 MapClass::RevealArea3 @0x00577D90  @0x00577EC5 (89 B8 34 01 00 00) mov [eax+0x134], edi
;            覆盖面：SpySat 全图开 + 旁路 @0x481FC3
;            保留：ShroudCounter<-0(@0x00577EBF) / CopyFlags|=0x18(@0x00577ED4)
;       P-2.3 MapClass::Reshroud    @0x00577AB0  @0x00577B60 (89 98 34 01 00 00) mov [eax+0x134], ebx
;            覆盖面：SpySat 离线重遮 + 旁路 @0x50BD20
;            保留：CopyFlags&=~0x18(@0x00577B4E) / ShroudCounter<-1(@0x00577B56) / RedrawFlags&=~0x3(@0x00577B66)
;       · 等长硬约束：6B==6B，禁 trampoline / 禁动 .detour 节；只许纯 90（禁 89→8B 等翻法：
;         P-2.2 的 edi、P-2.3 的 ebx 零常量在循环内仍被消费；cmp→jl/je 类邻接 flags 关系必须保持）。
;       · 窗前/窗后上下文窗按实测宽度自检（P-2.1 2+2B / P-2.2 6+6B / P-2.3 10+6B），任一不符整包不写。
;       · 若目标已是 90×6（外部安装者）：停手、只告警、不写不还原（Q1 门禁）。
;   0 = 不碰 .text（默认，零行为变化）。
;   ★ 安装序 P-2.1→P-2.2→P-2.3；硬回滚强制逆序 P-2.3→P-2.2→P-2.1；安装态在 init 决定
;     （本键只 LoadConfig 读一次）⇒ 改键须重启游戏/重载 DLL 生效。
;   ★ 遥测 gapProtectionPatchesInstalled ∈ 0..3 = 本进程实际写入的 NOP 点数（装几点算几点）；
;     启动日志打 GapProtection=on|off|forced-off-mp + installed=N，2 秒遥测行打印该计数；
;     仅 installed==3 才满足产品契约（存档标记 GapProt Version / MP 握手期望值）。
;   ★ 联机门控：MpActive=true 时**强制不装**（R-1 混端 DESYNC：+0x134 进 .SAV 且参与同步演进，
;     必须全端同构建同开关）。
;   ★ 只改已加载映像的内存字节：磁盘 gamemd.exe 只读不改（RE_COORDINATION 红线 §3-1）。
;   ★ 键名 EnableGapProtectP22/P23 不建、不占用（三点是一个保护包，同键一键装齐）。
;   ★ 真机验收：A1 默认无补丁不崩 / A2 =1 三点 6B=NOP、邻窗未动、installed=3 /
;     A3–A5 行为验收（敌方裂缝+开图后缝仍在 / 存读档 / 旁路未清零）走战役模式另卡
;     landing_pack_gap_p21_a3.md（ra2bench 遭遇战不可达：无预置建筑 + 触发器不触发）。
;   ★ 【G3-SPLIT】本键为修复选装（默认 0 = 原版行为），留在优化包；是否随玩法族迁入
;     [Gameplay] 由 Lead 裁决（见 RECEIPT.md 未裁决项 U2）。
EnableGapProtection=0
;
; ══ 【FOG-CAL2】灰雾净强度校准键（F1 换算订正 + 可达域扩展，2026-09-28）══
; FogStrengthPct = auto | <0..100>（默认 auto；数值允许小数，如 35.9375 / 71.875）
;   · T = 目标「净压暗（保留比例）」百分比 = 100 × 雾中像素亮度 / 同点无雾像素亮度。
;     ★方向：T **越大画面越亮**（桩强度 s 越小）；T = 35.9375 即现网 auto 观感；T = 71.875 为最亮上限。
;   · auto（默认；键缺失/空串/非法串都收敛为此）⇒ **不补偿**：桩强度保持设计值 s=256。
;   · 换算：m = (T/100) / 0.71875；s = clamp(round(512 × (1 − m)), 0, 511)（上限 511 非 512）。
;   · ★作用域：只改「已探索非直视」档压暗强度（与总闸同作用域；总闸全关时本键无消费方）。
;   · ★运行期判定：≈2 秒遥测节拍重读本键（SyncFogStrengthMirror）⇒ 一局内改键 ≈2 秒生效。
FogStrengthPct=auto

; ---------------------------------------------------------------------------
; [ZC-10B ①] L4DirtyMode —— L4 视口重绘策略（三档，默认 force-full = 现状）
;   force-full  （默认）= 恒强制全量重绘：与现网件逐位等价，零行为变化
;   vision-dirty       = 折中：仅当「视口内视野迁移数==0 且 视口渐变活跃数==0」时
;                         交还原版 jge（0x006D3D99 六字节原语义，走引擎增量/dirty-rect 路径）；否则仍强制全量
;   vanilla            = 完全交还原版 jge（等价于不打本补丁）
;   ★排雷：ini 缺失 / 非法值一律收敛为 force-full（安全侧，画面不变）。
; ---------------------------------------------------------------------------
L4DirtyMode=force-full

; ---------------------------------------------------------------------------
; [ZC-10B ③] FogProbe —— 桩内「读取值」探针键控（默认 0 = 关）
;   0（默认）= B1/B2 混色桩热路径的探针开关 2 条指令直接短路：不采样、不计数、不进慢路径
;             ⇒ 探针工作量为 0，混色算术路径逐位不变
;   1        = 热路径 +2 指令（cmp/je）采样【桩读取强度值】，2 秒遥测行含 fogprobe 明细
; ---------------------------------------------------------------------------
FogProbe=0

; ============================================================================
; 【G3-SPLIT 玩法配置节】（2026-10-19 拆分；出厂键全注释 = 全关 = 原版行为）
; ★节头说明：下一行 [Gameplay] 为**活动节头**（不带分号）——GetPrivateProfileStringA
;   按节名寻址的前提；本节头之后、文件末尾之前的去注释键才归属本节。
; ----------------------------------------------------------------------------
; ★ 为什么默认全关：项目规则「玩法改动要独立配置、不混进默认优化配置、默认保持原版行为」。
;   下列 13 键在旧版默认 ini 里被出厂置为非原版值（星际迷雾/主动雷达/迷雾隐形单位/寻敌节流），
;   违反该规则；本次全部迁入本节并注释化 ⇒ 出厂 = 原版。
; ★ 读取顺序（DLL 内三级回退，绝不写回本文件）：
;     ① 本节显式键（去行首「;」即生效，改后重启游戏）；
;     ② 旧节 [Logic]/[FogOfWar] 只读迁移回退（升级老用户保留开启态；启动日志
;        [ra2render-gameplay] 会列出命中项）；
;     ③ 原版默认全关（TargetScanInterval=1 / 各 Enable*=0 / VisibilityMode=vanilla）。
; ★ 联机门控（不受拆分影响，DLL 侧恒生效）：
;     TargetScanInterval 联机恒强制 1（G-08 锁步全量寻敌）；
;     TargetScanKey 联机恒强制 position（G-02 确定性坐标哈希）；
;     EnableMinimapFog 联机恒强制 0（G-01）；
;     EnableGapProtection（在 [FogOfWar]）联机强制不装 + MP 边沿硬回滚/门禁重装。
; ============================================================================
[Gameplay]

; ── ④ 寻敌频率节流（原默认 8 ⇒ 非原版；原版 = 1 每帧全量寻敌）────────────────
; TargetScanInterval: 分散敌对目标全图扫描频率（帧数）；原版 = 1。
; 单机大重载对局可用 8~16 降 O(N^2) 扫描开销；联机模式(MpActive)下无条件强制为 1（G-08）。
; 取值域 1..64（越界收敛）。
; TargetScanInterval=1
; L2 寻敌节流分片键：position=确定性坐标哈希（联机安全，默认）；pointer=旧指针哈希（仅单机）。
; 联机模式(MpActive)下强制 position；节流关闭（Interval=1）时本键无消费方。
; TargetScanKey=position

; ── ① 星际迷雾（灰雾压暗总闸 + 可见性模式；原版 = 双关）──────────────────────
; EnableStarCraftFog = 灰雾总闸。语义（FOG-SPLIT 2026-09-27 重定义）：
;   **只**管「已探索(引擎 cf_Explored) 且当前无我方/盟友直视」这一档的压暗强度。
;   =1：该档压暗强度 = 256（我方 50% 等效观感）；=0：该档压暗归零（小地图亦不驱动减暗）。
;   三态表：未探索格黑幕由引擎 SHROUD 路径绘制（与本键无关）；已探索+直视一律不压暗。
; EnableStarCraftFog=0
; VisibilityMode = starcraft | vanilla。可见性模式总键（F1，2026-09-28 用户裁决）。
;   vanilla（默认）= 原版可见性：不做任何视距剔除，单位/建筑/弹道三处剔除全部放行；
;   starcraft = 现状态：视距剔除生效，下列三子键按各自语义生效。
;   ★优先级：vanilla 时三子键被覆盖（忽略）；未知值收敛为 vanilla（安全侧）。
;   规范组合：[现状态] EnableStarCraftFog=1 + VisibilityMode=starcraft；
;             [原版态] EnableStarCraftFog=0 + VisibilityMode=vanilla。
; VisibilityMode=vanilla

; ── ② 间谍卫星主动雷达（原默认 1 ⇒ 非原版；原版 = 0 卫星全图常亮原语义）──────
; EnableSpySatRadarSweep：把间谍卫星重构为星际人族雷达（Scanner Sweep：有 CD 的区域扫描超武）。
; =0（默认）= 原版；=1 时下列两伴生键才有意义。init 懒加载一次性改写 BuildingType 数据
; （+0x16A5 常亮位、+0x16F0 超武索引），改键须重启；无运行期卸载（进程级生命周期）。
; EnableSpySatRadarSweep=0
; 雷达扫描超武冷却时间（帧数，默认 600 帧 ≈ 标准速度 40 秒 CD；下限 60）
; RadarSweepCooldownFrames=600
; 雷达扫描超武探测半径（格子数，默认 16；取值域 4..64）
; RadarSweepRadiusCells=16

; ── ③ 迷雾中隐藏敌方目标（三逻辑可见性键；原默认 1 ⇒ 非原版；原版 = 0）────────
; 敌方建筑迷雾化：从未被侦察过的敌建筑隐形；被侦察过则常驻可见（WC3 式“看见过即保持”）。
; 【FOG-SPLIT】逻辑可见性键：不受总闸影响（总闸=0 时仍然生效；由 Hook_Building_Draw 独立门控）
; EnableBuildingFog=0
; 迷雾中敌方弹道剔除：直视圈外敌方开火不再显示炮弹/火箭弹。
; 【FOG-SPLIT】逻辑可见性键：不受总闸影响（由 Hook_Bullet_Draw 独立门控）
; EnableBulletFog=0
; 迷雾中敌方机动单位剔除（坦克/步兵/战机）：非直视格上的敌方机动单位彻底隐形。
; 【FOG-SPLIT】逻辑可见性键：不受总闸影响（由 Hook_Unit/Infantry/Aircraft_Draw 独立门控）
; EnableUnitFog=0

; ── ①伴生 迷雾表现族（仅总闸=1 时有意义；默认值不变，随族迁移）──────────────
; 灰雾 4 帧渐变过渡：视野进出时灰雾平滑渐入渐出（SC2 式观感）。总闸=0 时自然失效。
; FadeFogTransition=1
; 雷达小地图迷雾化：迷雾区域小地图同步 50% 减暗。【G-01】默认 0；联机模式(MpActive)强制 0。
; 【RADAR-FIX2 待裁决】尚未通过真机验收（ZC-3 未跑），出厂保持 0。
; EnableMinimapFog=0
; 雷达灰化档位【RADAR-FIX2 F2】：3 = 引擎原生减暗驱动（默认）；0/1/2 = 自绘灰化对照档。
; 仅 EnableMinimapFog 生效时被消费；缺失/越界收敛为 3。
; RadarFogGuardMode=3
