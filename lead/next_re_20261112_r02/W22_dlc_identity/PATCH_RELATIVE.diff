+def _rollback(game: Path, undo: list) -> list[str]:
+    """ORPHAN-FIX01: best-effort undo of what a FAILED install already wrote.
+
+    Replaced files are restored from the backup slot created for them THIS run
+    (pre-existing "keep" slots are restored but kept); created files are
+    unlinked; an orphan removal is undone by re-installing the file from the
+    previous package the old record names, when that package still holds bytes
+    matching the recorded sha256. Everything goes through the same staged
+    primitives; a rollback that cannot restore something says so instead of
+    pretending. Returns report lines for the raised error.
+    """
+    lines: list[str] = []
+    for u in reversed(undo):
+        try:
+            if u["kind"] == "copy_step":
+                step = u["step"]
+                name = step["name"]
+                dest = game / name
+                if step["backup"] in ("create", "keep"):
+                    slot = name + BACKUP_SUFFIX
+                    bak = game / slot
+                    if bak.is_file():
+                        _stage_and_replace(bak, dest, None, "rollback-restore")
