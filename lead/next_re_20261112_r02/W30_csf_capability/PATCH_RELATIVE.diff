+def ts_crc_hash(filename: str) -> int:
+    """Westwood TS/RA2 MIX file ID (CRC-32 with 4-byte-tail length padding)."""
+    b = filename.upper().encode("ascii", "replace")
+    length = len(b)
+    aligned = length >> 2
+    if length & 3:
+        b = b + bytes([length - (aligned << 2)]) + bytes([b[aligned << 2]]) * (3 - (length & 3))
+    return zlib.crc32(b) & 0xFFFFFFFF
+
