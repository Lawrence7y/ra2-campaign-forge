+        raise CsfIncompleteError(

+            f"official CSF baseline label set has {len(names)} names, expected "

+            f"{OFFICIAL_CSF_LABEL_COUNT} - bundled resource is corrupt")

+    return frozenset(n.upper() for n in names)

