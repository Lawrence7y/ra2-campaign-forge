 "_recompute_minimal_command": "cd /home/t628/projects/ra2-campaign-forge && timeout 120 python3 - <<'EOF'\nimport struct,re,collections,pefile\nP='ra2bench/gamemd.exe';d=open(P,'rb').read();IB=0x400000\nS=[(s.VirtualAddress,max(s.Misc_VirtualSize,s.SizeOfRawData),s.PointerToRawData) for s in pefile.PE(P,fast_load=True).sections]\ndef r2o(v):\n    for va,sz,ro in S:\n        if va<=v-IB<va+sz: return ro+v-IB-va\ndef o2v(o):\n    for va,sz,ro in S:\n        if ro<=o<ro+sz: return va+IB+o-ro\nu=lambda v:(lambda o: None if o is None or o+4>len(d) else struct.unpack_from('<I',d,o)[0])(r2o(v))\nidx=collections.defaultdict(list)\nfor o in range(0,len(d)-3,4): idx[struct.unpack_from('<I',d,o)[0]].append(o)\nT={}\nfor m in re.finditer(rb'\\.\\?A(V|U)[^\\x00]{1,220}@@',d):\n    v=o2v(m.start())\n    if v and u(v-8)==0x7F9594: T[v-8]=d[m.start():d.find(b'\\x00',m.start())].decode('latin-1')\nC={}\nfor td in T:\n    for o in idx.get(td,[]):\n        col=o2v(o)-12\n        if col is None or u(col) not in (0,1,2) or u(col+8)!=0: continue\n        ch=u(col+16)\n        if ch is not None and r2o(ch) is not None: C[col]=(td,u(col+4),ch)\nB={}\nfor ch in {v[2] for v in C.values()}:\n    lst=[]\n    for i in range(u(ch+8)):\n        e=u(u(ch+12)+4*i)\n        if e and r2o(e) is not None and u(e) in T: lst.append((u(e),u(e+4),u(e+8),u(e+20)))\n    B[ch]=lst\nV={ch:{md for td,md,c2 in C.values() if c2==ch and md} for ch in B}\nO={td for td,md,ch in C.values() if md==0};I={t for t,n in T.items() if n.startswith('.?AU')}\nf=lambda ch,flt:{x[2] for x in B[ch] if x[2] and flt(x)}\nprint('TD',len(T),'COL',len(C),'CHD',len(B),'BCAelems',sum(map(len,B.values())),'BCA_mdis_nonzero',sum(1 for v in B.values() for x in v if x[2]))\nfor k,flt in (('G2',lambda x:x[0] in I or x[0] in O),('G3',lambda x:not T[x[0]].startswith('.?AV') or x[0] in O),('G4',lambda x:1),('G5',lambda x:x[0] in O),('G6',lambda x:T[x[0]].startswith('.?AU'))):\n    print(k,'mismatch',sum(1 for ch in V if V[ch]!=f(ch,flt)))\nEOF\n"
}