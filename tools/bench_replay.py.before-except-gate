# [ZC-11 closeout] 进对局确认前禁用 ESC：加载中 ESC×2 会打断开局（units_seen 恒 0）。
# 仅拦截 ESC（0x1B）；其它键不受影响。ZC-10A 的 verify_screen/close_pause_menu/
# reset_camera/--game-dir 行为保持不变。
_ESC_LOCKED = False


def set_esc_locked(locked: bool) -> bool:
    """全局 ESC 门禁：True=禁用 ESC。返回先前状态。"""
    global _ESC_LOCKED
    prev = _ESC_LOCKED
    _ESC_LOCKED = bool(locked)
    return prev


def press_key(vk: int, hold: float = 0.04):
    if vk == 0x1B and _ESC_LOCKED:
        return  # 进对局确认前禁用 ESC（ZC-11 [9]④：加载中 ESC 打断开局）
    user32.keybd_event(vk, 0, 0, 0)
    time.sleep(hold)
    user32.keybd_event(vk, 0, 2, 0)
    time.sleep(0.15)


class ShotSession:
    """证据标准 v2：同一次验收内各步截图 MD5 必须互异；重复=该步失败→重试→记录。"""

    def __init__(self):
        self.seen_md5: dict[str, str] = {}
        self.failures: list[dict] = []

    def step(self, hwnd: int, path: Path, *, action=None, retries: int = 3, gap: float = 1.5) -> dict:
        last = None
        for attempt in range(1 + retries):
            if attempt and action:
                action()
            last = grab(hwnd, path)
            if last["md5"] not in self.seen_md5:
                self.seen_md5[last["md5"]] = str(path)
                last["step_ok"] = True
                last["attempt"] = attempt
                return last
            time.sleep(gap)
        last["step_ok"] = False
        last["attempt"] = retries
        last["dup_of"] = self.seen_md5.get(last["md5"], "?")
        self.failures.append({"step": str(path), "md5": last["md5"], "dup_of": last["dup_of"]})
        return last

    def snapshot(self) -> dict:
        return {"seen_md5_count": len(self.seen_md5), "failures": self.failures}


def grab(hwnd: int, path: Path) -> dict:
    """从屏幕 DC 抓游戏窗口区域；返回可复算校验字段。"""
    import ctypes as c2
    gdi32 = c2.WinDLL("gdi32")
    from PIL import Image
    path.parent.mkdir(parents=True, exist_ok=True)
    l, t, r, b = window_bbox(hwnd)
    w, h = max(r - l, 8), max(b - t, 8)
    sdc = user32.GetDC(0)
    mdc = gdi32.CreateCompatibleDC(sdc)
    hbmp = gdi32.CreateCompatibleBitmap(sdc, w, h)
    gdi32.SelectObject(mdc, hbmp)
    gdi32.BitBlt(mdc, 0, 0, w, h, sdc, l, t, 0x00CC0020)

    class BMIH(c2.Structure):
        _fields_ = [("biSize", c2.c_ulong), ("biWidth", c2.c_long), ("biHeight", c2.c_long),
                    ("biPlanes", c2.c_ushort), ("biBitCount", c2.c_ushort), ("biCompression", c2.c_ulong),
                    ("biSizeImage", c2.c_ulong), ("biXPPM", c2.c_long), ("biYPPM", c2.c_long),
                    ("biClrUsed", c2.c_ulong), ("biClrImportant", c2.c_ulong)]

    bmi = BMIH(ctypes.sizeof(BMIH), w, -h, 1, 32, 0, 0, 0, 0, 0, 0)
    buf = ctypes.create_string_buffer(w * h * 4)
    gdi32.GetDIBits(mdc, hbmp, 0, h, buf, ctypes.byref(bmi), 0)
    img = Image.frombuffer("RGB", (w, h), buf.raw, "raw", "BGRX", 0, 1)
    img.save(path)
    gdi32.DeleteObject(hbmp)
    gdi32.DeleteDC(mdc)
    user32.ReleaseDC(0, sdc)

    # —— 证据标准：真实内容校验（尺寸 / 字节量 / MD5 / 唯一色数 / 亮度方差） ——
    raw = path.read_bytes()
    small = img.resize((min(w, 256), min(h, 256)))
    colors = len(set(small.getdata()))
    gray = list(small.convert("L").getdata())
    mean = sum(gray) / len(gray)
    var = sum((x - mean) ** 2 for x in gray) / len(gray)
    return {
        "path": str(path if path.is_absolute() else (PROJECT / path).resolve()),
        "width": w, "height": h,
        "bytes": len(raw),
        "md5": hashlib.md5(raw).hexdigest(),
        "sha256": hashlib.sha256(raw).hexdigest()[:16],
        "unique_colors_256": colors,
        "luma_variance": round(var, 1),
        "plausible": bool(colors > 64 and var > 100 and len(raw) > 100_000),
    }


