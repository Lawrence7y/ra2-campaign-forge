def run_tier(tier: int, *, windows: int, window_s: float, warmup_s: float,
             no_render: bool, no_compat: bool, shots: Path,
             cam_align: bool = False) -> list[dict]:
    base = f"0LoadBench_U{tier:04d}"
    # [Lead 2026-09-28] 兼容 H1 重制图（[v1.8.30] 14-house fanout）：旧图 base 优先，其次 base_H1；--map-suffix 可显式指定
    if MAP_SUFFIX:
        cands = [base + MAP_SUFFIX]
    else:
        cands = [base, base + "_H1"]
    map_name = next((c for c in cands if (GAME_DIR / f"[2]{c}.yrm").is_file()), None)
    if map_name is None:
        raise SystemExit(
            f"[FAIL] 游戏目录缺基准地图 [2]{base}.yrm（H1 变体 [2]{base}_H1.yrm 亦未找到）；"
            f"地图属游戏目录，本工具不写入，请先安装。"
            f"注意：PowerShell 路径含 [2] 时必须用 -LiteralPath，否则 [2] 会被当通配符。")
    if map_name != base:
        print(f"  [map] 未找到 [2]{base}.yrm ⇒ 自动改用 [2]{map_name}.yrm（H1 变体）；"
              f"负载是否生效须以 units_seen 校验（旧图真机仅 21/22 单位）")

    kill_game()
    print(f"== U{tier} 变体 render={'off' if no_render else 'on'} compat={'off' if no_compat else 'on'}")
    stamp = datetime.now().strftime("%H%M%S")
    runs = []
    try:
        pid = launch(no_render=no_render, no_compat=no_compat)
        proc = open_proc(pid)
        hwnd = None
        t_end = time.time() + 15
        while time.time() < t_end and not hwnd:
            hwnd = find_game_hwnd(pid)
            time.sleep(0.5)
        time.sleep(6.0)
        ok, cnt = enter_battle(pid, hwnd, proc, expect_units=tier, shots=shots, tag=f"u{tier}_{stamp}")
        if not ok:
            print(f"  [SKIP] U{tier} 未进入对局/兵力校验未过（实测 {cnt}，期望≈{tier}）")
            return runs
        print(f"  对局确认：机动单位 {cnt}（期望≈{tier}），热身 {warmup_s:.0f}s …")
        time.sleep(warmup_s)
        if cam_align and hwnd:
            # 每档切换后镜头可能被战斗拽走 ⇒ 可重做对齐（箭头键等时闭环；禁小地图）
            ref = shots / f"u{tier}_{stamp}_cam_ref.png"
            if not ref.is_file():
                grab(hwnd, ref)
            ca = reset_camera_arrows(hwnd, shots=shots, tag=f"u{tier}_{stamp}_cam", ref=ref, tries=2)
            print(f"  [cam-align] ok={ca.get('ok')} "
                  f"mad={ca.get('quality', {}).get('full', {}).get('mad') if ca.get('quality') else ca.get('note')}")
        ini_state = read_render_ini()
        for w in range(windows):
            res = sample_window(pid, proc, window_s, 250.0)
            res.update({"tier": tier, "window": w + 1, "map": map_name,
                        "map_file": f"[2]{map_name}.yrm",
                        "units_seen": cnt,
                        "ra2render_ini": ini_state,
                        "variant": {"no_render": no_render, "no_compat": no_compat},
                        "telemetry_tail": parse_telemetry(GAME_DIR),
                        "ts": datetime.now().strftime("%H:%M:%S")})
            runs.append(res)
            print(f"    busy={res['busy_pct']}% render={res['render_busy_pct']}% "
                  f"logic={res['logic_busy_pct']}% fps={res['frames'].get('fps')} "
                  f"tick_miss={res['frames'].get('tick_miss')} cpu={res['cpu_pct_of_one_core']}%")
            time.sleep(2.0)
        grab(hwnd, shots / f"u{tier}_{stamp}_battle.png")
        return runs
    finally:
        kill_game()


