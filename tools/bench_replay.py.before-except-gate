def send_click(hwnd: int, lx: int, ly: int, *, lw: int = 800, lh: int = 600, hold: float = 0.12):
    """SendInput 注入点击（实测：mouse_event 对本游戏 UI 不生效，SendInput 才被读取）。"""
    raise_win(hwnd)
    l, t, r, b = window_bbox(hwnd)
    sx = l + int(lx / lw * (r - l))
    sy = t + int(ly / lh * (b - t))
    user32.SetCursorPos(sx, sy)
    time.sleep(0.3)
    a = _INP(type=0); a.u.mi = _MI(0, 0, 0, 0x0002, 0, None)
    b2 = _INP(type=0); b2.u.mi = _MI(0, 0, 0, 0x0004, 0, None)
    user32.SendInput(1, ctypes.byref(a), ctypes.sizeof(_INP))
    time.sleep(hold)
    user32.SendInput(1, ctypes.byref(b2), ctypes.sizeof(_INP))
    time.sleep(0.5)


def click_at(hwnd: int, lx: int, ly: int, *, lw: int = 800, lh: int = 600):
