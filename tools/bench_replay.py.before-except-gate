def _k32():
    if not getattr(kernel32, "_typed", False):
        kernel32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
        kernel32.Process32First.argtypes = [wintypes.HANDLE, ctypes.POINTER(PROCESSENTRY32)]
        kernel32.Process32Next.argtypes = [wintypes.HANDLE, ctypes.POINTER(PROCESSENTRY32)]
        kernel32.Thread32First.argtypes = [wintypes.HANDLE, ctypes.POINTER(THREADENTRY32)]
        kernel32.Thread32Next.argtypes = [wintypes.HANDLE, ctypes.POINTER(THREADENTRY32)]
        kernel32.Module32First.argtypes = [wintypes.HANDLE, ctypes.POINTER(MODULEENTRY32)]
        kernel32.Module32Next.argtypes = [wintypes.HANDLE, ctypes.POINTER(MODULEENTRY32)]
        kernel32.OpenThread.restype = wintypes.HANDLE
        kernel32.OpenThread.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        kernel32.OpenProcess.restype = wintypes.HANDLE
        kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        kernel32.SuspendThread.argtypes = [wintypes.HANDLE]
        kernel32.ResumeThread.argtypes = [wintypes.HANDLE]
        kernel32.GetThreadContext.argtypes = [wintypes.HANDLE, ctypes.POINTER(CONTEXT)]
        kernel32.ReadProcessMemory.argtypes = [wintypes.HANDLE, wintypes.LPCVOID, wintypes.LPVOID,
                                               ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t)]
        if hasattr(kernel32, "Wow64GetThreadContext"):
            kernel32.Wow64GetThreadContext.argtypes = [wintypes.HANDLE, ctypes.POINTER(CONTEXT)]
        kernel32._typed = True
    return kernel32


def find_pid(exe: str) -> int | None:
    k = _k32()
    snap = k.CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)
    if snap in (None, -1, 0xFFFFFFFFFFFFFFFF):
        return None
    try:
        pe = PROCESSENTRY32()
        pe.dwSize = ctypes.sizeof(pe)
        if not k.Process32First(snap, ctypes.byref(pe)):
            return None
        while True:
            if pe.szExeFile.decode("latin-1").lower() == exe.lower():
                return int(pe.th32ProcessID)
            if not k.Process32Next(snap, ctypes.byref(pe)):
                return None
    finally:
        k.CloseHandle(snap)


def list_threads(pid: int) -> list[int]:
    k = _k32()
    snap = k.CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0)
    out = []
    if snap in (None, -1, 0xFFFFFFFFFFFFFFFF):
        return out
    try:
        te = THREADENTRY32()
        te.dwSize = ctypes.sizeof(te)
        if k.Thread32First(snap, ctypes.byref(te)):
            while True:
                if te.th32OwnerProcessID == pid:
                    out.append(int(te.th32ThreadID))
                if not k.Thread32Next(snap, ctypes.byref(te)):
                    break
    finally:
        k.CloseHandle(snap)
    return out


def list_modules(pid: int) -> list:
    k = _k32()
    snap = k.CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | TH32CS_SNAPMODULE32, pid)
    out, seen = [], set()
    if snap in (None, -1, 0xFFFFFFFFFFFFFFFF):
        return out
    try:
        me = MODULEENTRY32()
        me.dwSize = ctypes.sizeof(me)
        if k.Module32First(snap, ctypes.byref(me)):
            while True:
                base = ctypes.cast(me.modBaseAddr, ctypes.c_void_p).value or 0
                key = (me.szModule.decode("latin-1").lower(), base)
                if key not in seen:
                    seen.add(key)
                    out.append((me.szModule.decode("latin-1"), base, int(me.modBaseSize)))
                if not k.Module32Next(snap, ctypes.byref(me)):
                    break
    finally:
        k.CloseHandle(snap)
    return out


def open_proc(pid: int) -> int:
    return _k32().OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ, False, pid)


def rpm(proc: int, addr: int, size: int) -> bytes | None:
    buf = ctypes.create_string_buffer(size)
    got = ctypes.c_size_t(0)
    if kernel32.ReadProcessMemory(proc, ctypes.c_void_p(addr), buf, size, ctypes.byref(got)) and got.value == size:
        return buf.raw
    return None


def rpm_u32(proc: int, addr: int) -> int | None:
    b = rpm(proc, addr, 4)
    return struct.unpack("<I", b)[0] if b and len(b) == 4 else None


def read_eip(tid: int) -> int | None:
    k = _k32()
    h = k.OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, False, tid)
    if not h:
        return None
    try:
        if k.SuspendThread(h) == 0xFFFFFFFF:
            return None
        try:
            ctx = CONTEXT()
            ctx.ContextFlags = CONTEXT_CONTROL
            ok = False
            if hasattr(k, "Wow64GetThreadContext"):
                ok = bool(k.Wow64GetThreadContext(h, ctypes.byref(ctx)))
            if not ok:
                ok = bool(k.GetThreadContext(h, ctypes.byref(ctx)))
            return int(ctx.Eip) if ok and ctx.Eip else None
        finally:
            k.ResumeThread(h)
    finally:
        k.CloseHandle(h)


def process_cpu(proc: int) -> tuple[float, float] | None:
    class FT(ctypes.Structure):
        _fields_ = [("dwLow", wintypes.DWORD), ("dwHigh", wintypes.DWORD)]

    def s(ft):
        return ((ft.dwHigh << 32) | ft.dwLow) / 1e7

    kt, ut, cr, ex = FT(), FT(), FT(), FT()
    if not kernel32.GetProcessTimes(proc, ctypes.byref(cr), ctypes.byref(ex), ctypes.byref(kt), ctypes.byref(ut)):
        return None
    return s(ut), s(kt)


