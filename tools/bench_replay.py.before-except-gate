V160_MANIFEST = V160_SHOTS / "manifest.json"


def _load_manifest() -> dict:
    if V160_MANIFEST.is_file():
        return json.loads(V160_MANIFEST.read_text(encoding="utf-8"))
    return {"session_start": datetime.now().isoformat(timespec="seconds"), "runs": [], "saves": []}


def _save_manifest(m: dict):
    V160_SHOTS.mkdir(parents=True, exist_ok=True)
    m["manifest_updated"] = datetime.now().isoformat(timespec="seconds")
    V160_MANIFEST.write_text(json.dumps(m, ensure_ascii=False, indent=2), encoding="utf-8")


def run_evidence_config(cfg_index: int, *, window_s: float = 12.0, expect_units: int = 800) -> dict | None:
    """单个矩阵配置的证据采集：开局 → 热身 → 3 张战场截图(校验) → 遥测留痕 → 存/读档(all_on)。
    结果合并进 manifest.json（可分多次调用，跨 bash 命令续跑）。"""
    matrix = default_matrix()
    keys = matrix[cfg_index]
    tag = "all_off" if not any(keys.values()) else ("all_on" if all(keys.values()) else f"mix{cfg_index}")
    shots = V160_SHOTS
    shots.mkdir(parents=True, exist_ok=True)

    print(f"== 证据配置 {cfg_index}: {tag} {keys}")
    bk = set_render_ini(keys)
    try:
        kill_game()
        pid = launch()
        proc = open_proc(pid)
        t_end = time.time() + 15
        hwnd = None
        while time.time() < t_end and not hwnd:
            hwnd = find_game_hwnd(pid)
            time.sleep(0.5)
        time.sleep(18.0)   # 菜单交互就绪需 ~20s（启动后地图列表扫描），必须等足
        ss = ShotSession()
        try_auto_nav(hwnd, shots, f"v160_{tag}", ss)
        ok, cnt = enter_battle(pid, hwnd, proc, expect_units=expect_units,
                               shots=shots, tag=f"v160_{tag}")
        if not ok:
            print(f"  [SKIP] 未进入对局/兵力校验未过（实测 {cnt}）")
            return None
        print(f"  对局确认：单位 {cnt}，热身 10s")
        time.sleep(10.0)

        shot_meta = []
        for k in range(3):
            time.sleep(1.5)
            shot_meta.append(grab(hwnd, shots / f"v160_{tag}_battle_{k}.png"))
        md5s = {m["md5"] for m in shot_meta}
        telemetry = parse_telemetry(GAME_DIR)
        run_rec = {
            "config": keys, "tag": tag, "cfg_index": cfg_index,
            "units_seen": cnt, "screenshots": shot_meta,
            "md5_all_distinct": len(md5s) == len(shot_meta),
            "shot_quality": [{ "plausible": m["plausible"], "bytes": m["bytes"],
                               "unique_colors_256": m["unique_colors_256"],
                               "luma_variance": m["luma_variance"]} for m in shot_meta],
            "telemetry_tail": telemetry,
            "except_fresh": _except_is_fresh(),
            "ts": datetime.now().strftime("%H:%M:%S"),
        }

        if all(keys.values()):
            run_rec["save_reload"] = _attempt_save_reload(hwnd, shots, tag)

        manifest = _load_manifest()
        manifest["runs"] = [r for r in manifest.get("runs", []) if r.get("tag") != tag]
        manifest["runs"].append(run_rec)
        _save_manifest(manifest)
        print(f"  截图 {len(shot_meta)}（MD5 互异: {run_rec['md5_all_distinct']}），遥测 {len(telemetry)} 行")
        return run_rec
    finally:
        restore_render_ini(bk)
        kill_game()


def _except_is_fresh() -> bool:
    """验收窗口内 except.txt 是否有新增（崩溃零容忍判据）。"""
    p = GAME_DIR / "except.txt"
    if not p.is_file():
        return False
    mt = p.stat().st_mtime
    return (time.time() - mt) < 3600 * 6 and mt > time.time() - 3600 * 6 and (datetime.now().timestamp() - mt) < 7200


def _attempt_save_reload(hwnd: int, shots: Path, tag: str) -> dict:
    """存档/读档往返：ESC → 儲存遊戲 → 槽位确认 → 验证 .SAV 落盘。"""
    rec = {"attempted": True}
    before = {p.name: p.stat().st_mtime for p in GAME_DIR.glob("*.sav")}
    try:
        press_key(0x1B); time.sleep(1.5)
        grab(hwnd, shots / f"v160_{tag}_esc_menu.png")
        send_click(hwnd, 700, 263); time.sleep(1.5)      # 側欄：儲存遊戲（坐标待校准）
        grab(hwnd, shots / f"v160_{tag}_save_dlg.png")
        send_click(hwnd, 400, 300); time.sleep(3.0)      # 儲存確認
        press_key(0x1B); time.sleep(1.0)
        after = {p.name: p.stat().st_mtime for p in GAME_DIR.glob("*.sav")}
        new_saves = [n for n, mt in after.items() if n not in before or mt > before.get(n, 0) + 5]
        rec["new_saves"] = [{"name": n, "bytes": (GAME_DIR / n).stat().st_size,
                             "mtime": datetime.fromtimestamp(after[n]).isoformat(timespec="seconds")}
                            for n in new_saves]
        rec["ok"] = bool(new_saves)
        grab(hwnd, shots / f"v160_{tag}_after_save.png")
    except Exception as e:
        rec["ok"] = False
        rec["error"] = str(e)
    return rec


def default_matrix() -> list[dict[str, bool]]:
    """基线(全关) → 全开 → 每键独立关闭（其余开）：覆盖独立回滚语义。"""
    all_off = {k: False for k in V160_KEYS}
    all_on = {k: True for k in V160_KEYS}
    out = [all_off, all_on]
    for k in V160_KEYS:
        m = {kk: True for kk in V160_KEYS}
        m[k] = False
        out.append(m)
    return out


