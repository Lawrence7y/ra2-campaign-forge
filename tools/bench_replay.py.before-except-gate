# ---------------- 汇总报告 ---------------------------------------------------

def summarize(run_files: list[Path]) -> Path:
    import collections
    groups: dict[tuple, list[dict]] = collections.defaultdict(list)
    for p in run_files:
        d = json.loads(p.read_text(encoding="utf-8"))
        key = (d.get("tier"), tuple(sorted((d.get("variant") or {}).items())))
        groups[key].append(d)

    today = date.today().strftime("%Y%m%d")
    lines = [
        f"# 基准报告（{today}）", "",
        f"- 采样器：`tools/bench_replay.py`（EIP 250Hz + CurrentFrame 100Hz 只读轮询 + GetProcessTimes 差分）",
        f"- 对局校验：CurrentFrame 推进 ≥3 fps 且 机动单位数 ∈ [0.5×, 1.6×] 期望——未过校验的样本不进本报告",
        f"- 口径（Q1H-R3 统一）：`noise` = wait(ntdll/win32u/kernelbase/kernel32/winmm/wow64*) "
        f"+ shim(AcGenral/AcLayers/AcSpecfc/acxtrnal 等兼容层) + sys_gui(user32/gdi32/uxtheme) "
        f"+ gpu(DDraw 呈现等待) + sys.other + unmapped；`valid` = gamemd.exe + ra2render.dll。",
        f"- 与 `tools/bench_filter.py`、`PROTOCOL.md` §5 同一集合（旧版本文案称“垫片计入 busy”，与代码不符，已订正）；",
        f"- 兼容垫片不计入 valid，但单独列 `shim_pct` 供审计（垫片挂钩 Sleep/DirectDrawCreate 会放大噪声）；",
        f"- render/logic 地址桶表见 `docs/re/bench_protocol_notes.md`。", "",
        "## 汇总（各窗口平均）", "",
        "| 档位 | 变体 | 窗口 | busy% | render% | logic% | FPS | 帧p50(ms) | p90 | TickMiss | CPU(单核%) |",
        "|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for (tier, variant), items in sorted(groups.items()):
        vname = ",".join(f"{k}={v}" for k, v in variant) or "default"
        def avg(key):
            vals = [it.get(key) or 0 for it in items]
            return sum(vals) / max(len(vals), 1)
        fstats = [it.get("frames") or {} for it in items]
        fps = round(sum(f.get("fps", 0) for f in fstats) / max(len(fstats), 1), 2)
        p50 = round(sum(f.get("frame_ms_p50", 0) for f in fstats) / max(len(fstats), 1), 1)
        p90 = round(sum(f.get("frame_ms_p90", 0) for f in fstats) / max(len(fstats), 1), 1)
        miss = round(sum(f.get("tick_miss", 0) for f in fstats) / max(len(fstats), 1), 1)
        cpu = round(avg("cpu_pct_of_one_core"), 1)
        lines.append(f"| U{tier} | {vname} | {len(items)} | {avg('busy_pct'):.1f} | "
                     f"{avg('render_busy_pct'):.1f} | {avg('logic_busy_pct'):.1f} | {fps} | {p50} | {p90} | {miss} | {cpu} |")
    lines += ["", "## 与旧基线（perf_U0800.json）的差异原因", "",
              "- 旧数据 98% 样本落 wait/垫片、blit=0：无对局内校验（旧截图全黑=盲导航，大概率在菜单采样）"
              "+ 旧口径把帧间等待与工作混算；本报告只采通过校验的对局窗口。",
              "- 兼容垫片（AcGenral）样本计入 busy（它是游戏 GDI/USER 调用的包装层，属真实工作）；"
              "可用 `--no-compat` 变体量化。", ""]
    # 命名纪律：工具自动产物带 _bench 后缀，绝不覆盖人工撰写的 report_<日期>.md（PROTOCOL §9）
    out = OUT / f"report_{today}_bench.md"
    out.write_text("\n".join(lines), encoding="utf-8")
    return out


def run_reset_cam_cli(*, ref_path: str = "", out_dir: str = "") -> int:
    """--reset-cam：对**已在运行**的游戏窗口做箭头键等时闭环复位（不启动游戏）。

    流程：找 gamemd 窗口 → 取/建 ref → RIGHT1.0s 挪走 → LEFT1.0s 等时反向 →
    MAD/NCC + ROADS 逐字节校验 → 落盘记录。禁止小地图点击。
    """
    import json as _json
    out = Path(out_dir) if out_dir else (PROJECT / "out" / "re_work" / "harness_closeout" / "cam_reset")
    out.mkdir(parents=True, exist_ok=True)
    pid = find_pid("gamemd.exe")
    if not pid:
        print("[FAIL] 未发现 gamemd.exe（--reset-cam 不启动游戏；请先手动开局）")
        return 1
    hwnd = find_game_hwnd(pid)
    if not hwnd:
        print(f"[FAIL] pid={pid} 未找到游戏窗口")
        return 1
    print(f"  [reset-cam] pid={pid} hwnd={hwnd}")
    ref = Path(ref_path) if ref_path else (out / "cam_ref.png")
    if not ref.is_file():
        m = grab(hwnd, ref)
        print(f"  [reset-cam] 新建基准帧 {ref} md5={m.get('md5')}")
    res = reset_camera_arrows(hwnd, shots=out, tag="camcli", ref=ref, tries=3)
    rec = {"pid": pid, "hwnd": hwnd, "ref": str(ref), "result": res}
    rp = out / "cam_reset_record.json"
    rp.write_text(_json.dumps(rec, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"  [reset-cam] ok={res.get('ok')} mad={res.get('quality', {}).get('full', {})}")
    print(f"  [reset-cam] 记录: {rp}")
    return 0 if res.get("ok") else 1


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="bench_replay")
    ap.add_argument("--tiers", nargs="*", type=int, default=[200, 800])
    ap.add_argument("--map-suffix", default="", help="基准图文件名后缀（如 _H1 = H1 重制图）；默认自动探测 base/base_H1")
    ap.add_argument("--game-dir", default="", help="游戏/基准目录（默认 ra2youli；基准环境分离后指向 ra2bench）")
    ap.add_argument("--windows", type=int, default=3)
    ap.add_argument("--window-seconds", type=float, default=20.0)
    ap.add_argument("--warmup", type=float, default=12.0)
    ap.add_argument("--no-render", action="store_true")
    ap.add_argument("--no-compat", action="store_true")
    ap.add_argument("--evidence", action="store_true", help="v1.6.0 四键矩阵全部 6 配置依次采集（建议改用 --evidence-config 分次）")
    ap.add_argument("--evidence-config", type=int, default=None, help="仅采集矩阵第 N 配置（0=全关 1=全开 2..5=单键关），合并进 manifest")
    ap.add_argument("--summarize", action="store_true")
    ap.add_argument("--menu-selftest", action="store_true", help="Q7 实机自检：启动停在主菜单跑采样，验证附着与过滤，结束后自动退出游戏")
    ap.add_argument("--ab-simd", action="store_true", help="Q4 A/B 联动：以 EnableSIMD=0/1 进行对比基准并输出对比报告")
    ap.add_argument("--ab-selftest", action="store_true",
                    help="Q4 离线自检：ini 切换零污染 + A/B 对比算术 + 帧统计口径（不启动游戏）")
    ap.add_argument("--cam-selftest", action="store_true",
                    help="ZC-11 箭头键复位 MAD/NCC 离线自检（用 segE3 截图，不启动游戏）")
    ap.add_argument("--reset-cam", action="store_true",
                    help="对已运行的游戏窗口执行箭头键等时闭环机位复位（RIGHT1.0s/LEFT1.0s；不启动游戏）")
    ap.add_argument("--reset-cam-ref", default="",
                    help="--reset-cam 的基准帧路径（缺省则先抓一张作 ref）")
    ap.add_argument("--reset-cam-out", default="",
                    help="--reset-cam 截图输出目录（默认 out/re_work/harness_closeout/cam_reset）")
    ap.add_argument("--cam-align", action="store_true",
                    help="每档进对局热身后做一次箭头键等时闭环对齐（RIGHT1.0s/LEFT1.0s + MAD/NCC）")
    args = ap.parse_args(argv)
    global MAP_SUFFIX, GAME_DIR
    MAP_SUFFIX = args.map_suffix or ""
    if args.game_dir:
        GAME_DIR = Path(args.game_dir)

    OUT.mkdir(parents=True, exist_ok=True)
    if args.cam_selftest:
        import bench_cam_reset
        return bench_cam_reset.selftest()

    if args.reset_cam:
        return run_reset_cam_cli(ref_path=args.reset_cam_ref or "",
                                 out_dir=args.reset_cam_out or "")
    if args.ab_selftest:
        return ab_selftest()

    if args.menu_selftest:
        res = run_menu_selftest(window_s=6.0, wait_s=20.0)
        return 0 if res["kill_confirmed"] else 1

    if args.ab_simd:
        res = run_ab_compare(tier=args.tiers[0] if args.tiers else 200, window_s=args.window_seconds, warmup_s=args.warmup)
        return 0

    if args.summarize:
        files = sorted(OUT.glob("bench_*_run*.json"))
        print("报告：", summarize(files))
        return 0

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    shots = SHOTS / f"session_{stamp}"
    if args.evidence or args.evidence_config is not None:
        if args.evidence:
            for i in range(6):
                run_evidence_config(i, window_s=args.window_seconds)
            print("\n证据清单：", V160_MANIFEST)
            return 0
        rec = run_evidence_config(args.evidence_config, window_s=args.window_seconds)
        print("\n证据清单：", V160_MANIFEST)
        return 0 if rec else 1

    all_runs: list[Path] = []
    for tier in args.tiers:
        runs = run_tier(tier, windows=args.windows, window_s=args.window_seconds,
                        warmup_s=args.warmup, no_render=args.no_render,
                        no_compat=args.no_compat, shots=shots,
                        cam_align=args.cam_align)
        for r in runs:
            p = OUT / f"bench_U{tier:04d}_{stamp}_run{r['window']}.json"
            p.write_text(json.dumps(r, ensure_ascii=False, indent=2), encoding="utf-8")
            all_runs.append(p)
    if all_runs:
        rep = summarize(all_runs)
        print("\n报告：", rep)
        print(f"截图：{shots}")
        return 0
    print("[FAIL] 无任何通过校验的采样窗口", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
