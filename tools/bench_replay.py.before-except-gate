            "1pct_low_b": f_b.get("fps_1pct_low", 0.0),
            "tick_miss_a": f_a.get("tick_miss", 0),
            "tick_miss_b": f_b.get("tick_miss", 0),
            "render_busy_pct_a": rec_a.get("render_busy_pct", 0.0),
            "render_busy_pct_b": rec_b.get("render_busy_pct", 0.0),
            "cpu_a": rec_a.get("cpu_pct_of_one_core"),
            "cpu_b": rec_b.get("cpu_pct_of_one_core"),
        }
    }

    ab_res["artifacts"] = ab_build_report(rec_a, rec_b, tier, stamp=stamp, tag="ab_simd")
    return ab_res

# ---------------- A/B 联动：可对比 JSON + Markdown（Q4） ---------------------

AB_SELFTEST_DIR = PROJECT / "out" / "re_work" / "bench_harness"


def ab_build_report(rec_a: dict, rec_b: dict, tier: int, *, stamp: "str | None" = None,
                    out_dir: "Path | None" = None, tag: str = "ab_simd") -> dict:
    """把两轮采样记录整理成**可对比 JSON + Markdown**（纯函数：不启动游戏、不碰 INI）。

    与 run_ab_compare 解耦，便于离线用**合成记录**自检「对比口径 / 门禁表达式 / 落盘命名」。
    口径纪律：差值只有在两轮都通过对局内校验且 valid_pct >= 10% 时才可作为收益证据。
    """
    stamp = stamp or datetime.now().strftime("%Y%m%d_%H%M%S")
    base = Path(out_dir) if out_dir is not None else AB_SELFTEST_DIR
    base.mkdir(parents=True, exist_ok=True)

    f_a = rec_a.get("frames") or {}
    f_b = rec_b.get("frames") or {}
    fps_a = f_a.get("fps_avg") or f_a.get("fps") or 0.0
    fps_b = f_b.get("fps_avg") or f_b.get("fps") or 0.0
    gain = round(100.0 * (fps_b - fps_a) / fps_a, 2) if fps_a > 0 else 0.0
    low_a, low_b = f_a.get("fps_1pct_low", 0.0), f_b.get("fps_1pct_low", 0.0)
    low_gain = round(100.0 * (low_b - low_a) / low_a, 2) if low_a > 0 else None
    tm_a, tm_b = f_a.get("tick_miss", 0), f_b.get("tick_miss", 0)

    res = {
        "timestamp": datetime.now().isoformat(timespec="seconds"),
        "tier": tier,
        "variant_a": {"EnableSIMD": False, "run": rec_a},
        "variant_b": {"EnableSIMD": True, "run": rec_b},
        "comparison": {
            "fps_a": fps_a, "fps_b": fps_b,
            "fps_delta": round(fps_b - fps_a, 3), "fps_gain_pct": gain,
            "1pct_low_a": low_a, "1pct_low_b": low_b,
            "1pct_low_delta": round(low_b - low_a, 3), "1pct_low_gain_pct": low_gain,
            "tick_miss_a": tm_a, "tick_miss_b": tm_b,
            "tick_miss_delta": (tm_b or 0) - (tm_a or 0),
            "render_busy_pct_a": rec_a.get("render_busy_pct", 0.0),
            "render_busy_pct_b": rec_b.get("render_busy_pct", 0.0),
            "render_of_gamemd_pct_a": rec_a.get("render_of_gamemd_pct", 0.0),
            "render_of_gamemd_pct_b": rec_b.get("render_of_gamemd_pct", 0.0),
            "cpu_a": rec_a.get("cpu_pct_of_one_core"), "cpu_b": rec_b.get("cpu_pct_of_one_core"),
            "valid_pct_a": rec_a.get("valid_pct"), "valid_pct_b": rec_b.get("valid_pct"),
            "units_seen_a": rec_a.get("units_seen"), "units_seen_b": rec_b.get("units_seen"),
        },
        "gate": {
            "fps_gain_ge_10pct": bool(gain >= 10.0),
            "low1_gain_ge_15pct": bool(low_gain is not None and low_gain >= 15.0),
            "both_valid_pct_ge_10": bool((rec_a.get("valid_pct") or 0) >= 10.0
                                         and (rec_b.get("valid_pct") or 0) >= 10.0),
            "note": "门禁表达式仅作可复算记录：真机 A/B 未跑过前不得据此宣称收益（PROTOCOL §10）",
        },
    }
    pj = base / f"{tag}_{stamp}.json"
    pm = base / f"{tag}_{stamp}.md"
    pj.write_text(json.dumps(res, ensure_ascii=False, indent=2), encoding="utf-8")
    pm.write_text(ab_render_markdown(res, rec_a, rec_b, tier, pj.name, pm.name), encoding="utf-8")
    print(f"  A/B 对比 JSON 已落盘: {pj}")
    print(f"  A/B 对比 Markdown 已落盘: {pm}")
    return {"json": str(pj), "md": str(pm)}


