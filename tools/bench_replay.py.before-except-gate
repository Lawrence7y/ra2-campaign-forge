                          no_render=False, no_compat=False, shots=shots)
    finally:
        restore_render_ini(bk_b)

    rec_a = runs_a[0] if runs_a else {}
    rec_b = runs_b[0] if runs_b else {}

    f_a = rec_a.get("frames", {})
    f_b = rec_b.get("frames", {})

    fps_a = f_a.get("fps_avg") or f_a.get("fps", 0.0)
    fps_b = f_b.get("fps_avg") or f_b.get("fps", 0.0)
    fps_gain = round(100.0 * (fps_b - fps_a) / max(fps_a, 0.01), 2) if fps_a > 0 else 0.0

    ab_res = {
        "timestamp": datetime.now().isoformat(timespec="seconds"),
        "tier": tier,
        "variant_a": {"EnableSIMD": False, "run": rec_a},
        "variant_b": {"EnableSIMD": True, "run": rec_b},
