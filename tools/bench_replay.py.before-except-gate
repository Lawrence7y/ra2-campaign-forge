class BattleMonitor:
    """ReadProcessMemory 只读监测：CurrentFrame 推进 + 机动单位数校验。"""

    def __init__(self, proc: int):
        self.proc = proc
        self.samples: list[tuple[float, int]] = []

    def frame(self) -> int:
        v = rpm_u32(self.proc, ADDR_CURRENT_FRAME)
        return v if v is not None else 0

    def mobile_count(self) -> int:
        """数组全局（如 0x008B4108）本身是 DynamicVectorClass 对象：count 在 +16 直读。"""
        n = 0
        for arr in (ARR_UNITS, ARR_INFANTRY, ARR_AIRCRAFT):
            cnt = rpm_u32(self.proc, arr + 16)
            if cnt and cnt < 100000:
                n += cnt
        return n

    def wait_in_battle(self, timeout: float, min_fps: float = 3.0) -> bool:
        t_end = time.time() + timeout
        while time.time() < t_end:
            f0, t0 = self.frame(), time.time()
            time.sleep(1.5)
            f1 = self.frame()
            if f1 > f0 and (f1 - f0) / (time.time() - t0) >= min_fps:
                return True
            time.sleep(0.5)
        return False

    def poll_frames(self, seconds: float, hz: float = 100.0, stop: threading.Event | None = None):
        interval = 1.0 / hz
        t_end = time.time() + seconds
        nxt = time.perf_counter()
        self.samples.clear()
        while time.perf_counter() < t_end and not (stop and stop.is_set()):
            self.samples.append((time.time(), self.frame()))
            nxt += interval
            d = nxt - time.perf_counter()
            if d > 0:
                time.sleep(d)
            else:
                nxt = time.perf_counter()
        return self.samples


def frame_stats(samples: list[tuple[float, int]], span: float) -> dict:
    if len(samples) < 10:
        return {"fps": 0.0, "note": "insufficient"}
    intervals = []
    for i in range(1, len(samples)):
        dt = samples[i][0] - samples[i - 1][0]
        df = samples[i][1] - samples[i - 1][1]
        if df > 0 and dt > 0:
            intervals.append(dt / df)
    if not intervals:
        return {"fps": 0.0, "note": "frame not advancing"}
    s = sorted(intervals)
    p = lambda q: s[min(len(s) - 1, int(q * len(s)))]  # noqa: E731
    p50 = p(0.50)
    p90 = p(0.90)
    p99 = p(0.99)
    misses = [x for x in s if x > 1.5 * p50]
    total_frames = int(samples[-1][1] - samples[0][1])
    fps_avg = round(total_frames / span, 2) if span > 0 else 0.0
    fps_1pct_low = round(1.0 / p99, 2) if p99 > 0 else 0.0
    return {
        "fps": round(1.0 / p50, 2),
        "fps_avg": fps_avg,
        "fps_1pct_low": fps_1pct_low,
        "frame_ms_p50": round(p50 * 1000, 2),
        "frame_ms_p90": round(p90 * 1000, 2),
        "frame_ms_p99": round(p99 * 1000, 2),
        "frame_ms_max": round(s[-1] * 1000, 2),
        "tick_miss": len(misses),
        "tick_miss_rate": round(len(misses) / len(s), 4),
        "logic_frames": total_frames,
        "span_s": round(span, 2),
    }


