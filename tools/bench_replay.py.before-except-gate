    # 轮次 A: EnableSIMD=0
    bk_a = set_render_ini({"EnableSIMD": False})
    runs_a = []
    try:
        print("  --> 轮次 A: EnableSIMD=0 ...")
        runs_a = run_tier(tier, windows=1, window_s=window_s, warmup_s=warmup_s,
                          no_render=False, no_compat=False, shots=shots)
    finally:
        restore_render_ini(bk_a)

