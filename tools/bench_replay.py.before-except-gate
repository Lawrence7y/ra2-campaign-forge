def find_game_hwnd(pid: int) -> int | None:
    """找 gamemd 的顶层窗口。cnc-ddraw 全屏模式失焦会隐藏/最小化窗口，
    故不做 IsWindowVisible 过滤（先找到，再由 focus_game 恢复）。"""
    result = {"hwnd": None, "fallback": None}
    pid_buf = ctypes.c_ulong()

    @ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
    def proc(hwnd, _):
        user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid_buf))
        if pid_buf.value == pid:
            r = wintypes.RECT()
            user32.GetWindowRect(hwnd, ctypes.byref(r))
            if r.right - r.left > 200 or (r.right == 0 and r.left == 0):
                if user32.IsWindowVisible(hwnd) and result["hwnd"] is None:
                    result["hwnd"] = hwnd
                elif result["fallback"] is None:
                    result["fallback"] = hwnd
        return True

    user32.EnumWindows(proc, 0)
    return result["hwnd"] or result["fallback"]


def window_bbox(hwnd: int):
    r = wintypes.RECT()
    hr = dwmapi.DwmGetWindowAttribute(ctypes.c_void_p(hwnd), 9, ctypes.byref(r), ctypes.sizeof(r))
    if hr == 0 and r.right > r.left:
        return r.left, r.top, r.right, r.bottom
    user32.GetWindowRect(hwnd, ctypes.byref(r))
    return r.left, r.top, r.right, r.bottom


def raise_win(hwnd: int):
    user32.ShowWindow(hwnd, 9)
    user32.SetForegroundWindow(hwnd)
    time.sleep(0.25)


def focus_game(hwnd: int, attempts: int = 3) -> bool:
    """强制前台（分离启动的窗口常无焦点；点击落在别的窗口=导航全废）。
    手段：最小化其他窗口 → AttachThreadInput 抢焦点 → ALT-ALT 兜底 → 校验。"""
    SW_MINIMIZE = 6

    def minimize_others():
        pid_buf = ctypes.c_ulong()

        @ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
        def proc(h, _):
            if h == hwnd or not user32.IsWindowVisible(h):
                return True
            cls = ctypes.create_unicode_buffer(256)
            user32.GetClassNameW(h, cls, 256)
            if cls.value in ("Shell_TrayWnd", "Progman", "WorkerW", "Windows.UI.Core.CoreWindow"):
                return True
            user32.ShowWindow(h, SW_MINIMIZE)
            return True

        user32.EnumWindows(proc, 0)

    for i in range(attempts):
        user32.ShowWindow(hwnd, 9)          # SW_RESTORE：先恢复被 cnc-ddraw 隐藏的窗口
        time.sleep(0.2)
        minimize_others()
        user32.BringWindowToTop(hwnd)
        fg = user32.GetForegroundWindow()
        if fg == hwnd:
            return True
        # AttachThreadInput 抢焦点
        cur = kernel32.GetCurrentThreadId()
        tgt = user32.GetWindowThreadProcessId(hwnd, None)
        user32.AttachThreadInput(cur, tgt, True)
        user32.SetForegroundWindow(hwnd)
        user32.AttachThreadInput(cur, tgt, False)
        time.sleep(0.3)
        if user32.GetForegroundWindow() == hwnd:
            return True
        # ALT 按放绕过前台锁
        user32.keybd_event(0x12, 0, 0, 0)
        user32.keybd_event(0x12, 0, 2, 0)
        user32.SetForegroundWindow(hwnd)
        time.sleep(0.3)
        if user32.GetForegroundWindow() == hwnd:
            return True
        time.sleep(0.5)
    return user32.GetForegroundWindow() == hwnd


