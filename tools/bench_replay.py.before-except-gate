def grab_region(hwnd: int, x0: int, y0: int, w: int, h: int,
                path: Path | None = None) -> dict | None:
    """按屏幕坐标抓取窗口内矩形（BitBlt 屏幕 DC；不抢焦点、不最小化其它窗口）。"""
    import ctypes as c2
    import tempfile
    from PIL import Image
    if w <= 0 or h <= 0:
        return None
    gdi32 = c2.WinDLL("gdi32")
    sdc = user32.GetDC(0)
    mdc = gdi32.CreateCompatibleDC(sdc)
    hbmp = gdi32.CreateCompatibleBitmap(sdc, w, h)
    gdi32.SelectObject(mdc, hbmp)
    gdi32.BitBlt(mdc, 0, 0, w, h, sdc, x0, y0, 0x00CC0020)

    class BMIH(c2.Structure):
        _fields_ = [("biSize", c2.c_ulong), ("biWidth", c2.c_long), ("biHeight", c2.c_long),
                    ("biPlanes", c2.c_ushort), ("biBitCount", c2.c_ushort), ("biCompression", c2.c_ulong),
                    ("biSizeImage", c2.c_ulong), ("biXPPM", c2.c_long), ("biYPPM", c2.c_long),
                    ("biClrUsed", c2.c_long), ("biClrImportant", c2.c_long)]

    bmi = BMIH(ctypes.sizeof(BMIH), w, -h, 1, 32, 0, 0, 0, 0, 0, 0)
    buf = c2.create_string_buffer(w * h * 4)
    gdi32.GetDIBits(mdc, hbmp, 0, h, buf, ctypes.byref(bmi), 0)
    img = Image.frombuffer("RGB", (w, h), buf.raw, "raw", "BGRX", 0, 1)
    p = path or Path(tempfile.mkdtemp(prefix="br_region_")) / "r.png"
    p.parent.mkdir(parents=True, exist_ok=True)
    img.save(p)
    gdi32.DeleteObject(hbmp); gdi32.DeleteDC(mdc); user32.ReleaseDC(0, sdc)
    return {"path": str(p), "width": w, "height": h,
            "md5": hashlib.md5(p.read_bytes()).hexdigest()}


def sidebar_red_buttons(hwnd: int) -> list[int]:
    """语义指纹①：侧边栏红钮的 y 中心列表（逻辑 800x600 坐标）。
    实现：对侧栏 x∈[640,800) 逐行统计「R>G+40 且 R>B+40」占比，>25% 且连续 ≥8 行
    记为一个红钮，取中心 y 并折算回逻辑坐标。"""
    import numpy as np
    from PIL import Image
    l, t, r, b = window_bbox(hwnd)
    sx0 = l + int(640 / 800 * (r - l))
    m = grab_region(hwnd, sx0, t, (r - l) - (sx0 - l), b - t)
    if m is None or not m.get("path"):
        return []
    a = np.asarray(Image.open(m["path"]).convert("RGB")).astype(int)
    H = a.shape[0]
    rf = ((a[:, :, 0] > a[:, :, 1] + 40) & (a[:, :, 0] > a[:, :, 2] + 40)).mean(axis=1)
    out, inb = [], False
    for y in range(H):
        v = rf[y] > 0.25
        if v and not inb:
            inb, y0 = True, y
        elif not v and inb:
            inb = False
            if y - y0 >= 8:
                out.append(int(round((y0 + y - 1) / 2 / H * 600)))
    return out


def tactical_color_count(hwnd: int) -> int:
    """语义指纹②：战术区唯一色数 —— 被暂停菜单/过场盖住时会塌到 ~365。

    ★坐标口径：战术区 = 窗口左侧（侧边栏以左）。侧边栏宽度随窗口尺寸变（800×600 时占
      20%，1366×768 时占 10%），故按窗口宽度的 86% 取左半，避免越界抓取窗外内容
      （ZC-10A 首版误把 1230 当逻辑坐标 ⇒ 1.5375×窗宽 ⇒ 抓到窗外 ⇒ 指纹失效）。
    """
    import tempfile
    import numpy as np
    from PIL import Image
    l, t, r, b = window_bbox(hwnd)
    m = grab(hwnd, Path(tempfile.gettempdir()) / "br_tac.png")
    if m is None or not m.get("plausible"):
        return -1
    a = np.asarray(Image.open(m["path"]).convert("RGB"))
    w = int(a.shape[1] * 0.86)
    a = a[:, :w]
    return len(set(map(tuple, a.reshape(-1, 3).tolist()))) if a.size else -1


def screen_fingerprint(hwnd: int) -> dict:
    """当前画面的语义指纹（不依赖背景动画/视频帧，抗假阳性）。"""
    rb = sidebar_red_buttons(hwnd)
    tc = tactical_color_count(hwnd)
    return {"red_buttons": rb, "tactical_colors": tc,
            "is_tactical": tc >= TACTICAL_COLOR_FLOOR}


def verify_screen(hwnd: int, expect: str, tol: int = 3) -> dict:
    """语义化导航校验：当前画面是否就是 expect 指定的目标界面。
    expect ∈ SCREEN_RED_BUTTONS 的键（含 battle / pause_menu）。"""
    fp = screen_fingerprint(hwnd)
    want = list(SCREEN_RED_BUTTONS[expect])
    if expect == "pause_menu":
        ok, reason = (not fp["is_tactical"]), f"tactical_colors={fp['tactical_colors']}"
    elif expect == "battle":
        ok, reason = fp["is_tactical"], f"tactical_colors={fp['tactical_colors']} (floor={TACTICAL_COLOR_FLOOR})"
    else:
        got = fp["red_buttons"]
        ok = (len(got) == len(want)
              and all(abs(g - w) <= tol for g, w in zip(got, want)))
        reason = f"red_buttons got={got} want={want} tol=±{tol}"
    return {"ok": bool(ok), "expect": expect, "got": fp, "want": want, "reason": reason}


def wait_battle_ready(mon: "BattleMonitor", hwnd: int, *, timeout: float = 5.0,
                      min_fps: float = 3.0, frame_floor: int = 0,
                      use_screen: bool = True) -> bool:
    """加载期/进对局双校验：帧推进 + 战术区色数（ZC-11 segC/segE 已验证口径）。

    ① 帧推进：CurrentFrame 差分 ≥ min_fps（与 BattleMonitor.wait_in_battle 同口径）；
    ② 战术区色数：verify_screen(hwnd, "battle")（TACTICAL_COLOR_FLOOR）。
    两者同时满足才判定「已进对局」。加载中 ESC 会打断开局 ⇒ 调用方须先
    set_esc_locked(True)；本函数只读监测，不注入任何按键。
    """
    t_end = time.time() + timeout
    while time.time() < t_end:
        f0, t0 = mon.frame(), time.time()
        slice_s = min(1.5, max(0.15, t_end - time.time()))
        time.sleep(slice_s)
        if time.time() > t_end + 0.05:
            break
        f1 = mon.frame()
        dt = time.time() - t0
        frame_ok = f1 > f0 and dt > 0 and (f1 - f0) / dt >= min_fps
        if f1 < frame_floor:
            continue
        if not use_screen:
            if frame_ok:
                return True
            continue
        v = verify_screen(hwnd, "battle")
        if frame_ok and v["ok"]:
            return True
    return False


def close_pause_menu(hwnd: int, *, tries: int = 4) -> dict:
    """关闭暂停菜单并校验已回到战术视图。

    ★ESC 不可用：user32.keybd_event(0x1B) 到不了 DirectInput 游戏（ZC-9B 实测：
      ESC 能打开暂停菜单却关不掉）。唯一可靠路径是鼠标点右下「回到任務」蓝钮。
    """
    import time as _t
    last = None
    for i in range(tries):
        v = verify_screen(hwnd, "battle")
        last = v
        if v["ok"]:
            return {"ok": True, "attempts": i + 1, "verify": v}
        focus_game(hwnd)
        send_click(hwnd, *BACK_TO_MISSION, lw=800, lh=600)
        _t.sleep(1.8)
        last = verify_screen(hwnd, "battle")
        if last["ok"]:
            return {"ok": True, "attempts": i + 1, "verify": last}
    return {"ok": False, "attempts": tries, "verify": last}


def read_viewport_rect(hwnd: int) -> dict | None:
    """读小地图内的视口矩形（= 镜头所在地图位置）屏幕坐标。
    实现：小地图框在侧栏右上（逻辑 x≥1215, y∈[30,195)），视口矩形是框内亮边矩形。"""
    import numpy as np
    from PIL import Image
    l, t, r, b = window_bbox(hwnd)
    x0 = l + int(1215 / 800 * (r - l))
    y0 = t + int(30 / 600 * (b - t))
    w = (r - l) - (x0 - l)
    h = int(165 / 600 * (b - t))
    m = grab_region(hwnd, x0, y0, w, h)
    if m is None or not m.get("path"):
        return None
    a = np.asarray(Image.open(m["path"]).convert("RGB")).astype(int)
    lum = 0.299 * a[:, :, 0] + 0.587 * a[:, :, 1] + 0.114 * a[:, :, 2]
    vp = lum > 150
    if not vp.any():
        return None
    vy, vx = np.where(vp)
    return {"x0": int(vx.min() + x0), "y0": int(vy.min() + y0),
            "x1": int(vx.max() + x0), "y1": int(vy.max() + y0),
            "cx": int((vx.min() + vx.max()) // 2 + x0),
            "cy": int((vy.min() + vy.max()) // 2 + y0),
            "px": int((vx.max() - vx.min())), "py": int((vy.max() - vy.min()))}


def reset_camera(hwnd: int, *, anchor=MINIMAP_ANCHOR, tries: int = 3,
                 ref: Path | None = None, mad_tol: float = 1.0,
                 shots: Path | None = None, tag: str = "cam") -> dict:
    """确定性机位复位：点小地图内固定锚点，把战术视角钉到同一地图格。

    ★ZC-11：小地图点击复位**已禁用**（ZC-10A FAIL：点击无效时 MAD=0 属空洞成功）。
      本函数保留以兼容 ZC-10A 调用方，但对齐/复位请改用 reset_camera_arrows()
      （箭头键等时闭环，ZC-11 segE3 验证：MAD 0.13 / NCC 0.996 / ROADS 逐字节 0 差）。

    成功校验：
      ① 与基准帧整帧 MAD <= mad_tol（shots/ref 提供时）；
      ② 小地图视口矩形中心与上一次数值一致（由调用方用 read_viewport_rect() 判）。
    返回 {ok, attempts, mad}。
    """
    import time as _t
    import numpy as np
    from PIL import Image
    if shots is not None:
        shots.mkdir(parents=True, exist_ok=True)
    out = {"ok": False, "attempts": 0, "mad": None, "anchor": anchor}
    for i in range(tries):
        out["attempts"] = i + 1
        close_pause_menu(hwnd)
        focus_game(hwnd)
        send_click(hwnd, anchor[0], anchor[1], lw=800, lh=600)
        _t.sleep(1.6)
        if shots is None:
            continue
        p = shots / f"{tag}_try{i}.png"
        if ref is None:
            m = grab(hwnd, p)
            if m and m.get("plausible"):
                out.update(ok=True, mad=0.0, ref=str(p))
                return out
        else:
            m = grab(hwnd, p)
            if m and ref.is_file():
                A = np.asarray(Image.open(ref).convert("RGB")).astype(int)
                B = np.asarray(Image.open(p).convert("RGB")).astype(int)
                out["mad"] = round(float(np.abs(A - B).mean()), 4)
                if out["mad"] <= mad_tol:
                    out["ok"] = True
                    return out
    return out


