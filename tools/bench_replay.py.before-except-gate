def try_auto_nav(hwnd: int, shots: Path, tag: str, ss: "ShotSession | None" = None,
                 *, allow_esc: bool = True):
    """已校准自动导航 + **语义化目标画面校验**重试：跳过开场 → 單人遊戲 → 遭遇戰 → 開始遊戲。

    ★ZC-10A 硬化：判据从「侧边栏像素变了」升级为「落在目标界面」：
      每步点击后用 verify_screen() 检查红钮签名/战术区色数，只有真正到达
      mainmenu→sp_submenu→skirmish_setup→battle 才算通过。
      旧判据 sidebar_changed() 在点到「載入儲存遊戲」时同样返回 True（假阳性），
      正是 ZC-9B 段 C 导航失败的根因。
    ★ZC-11 closeout：allow_esc=False（或全局 set_esc_locked(True)）时**不按 ESC**。
      进对局确认前必须禁 ESC——加载中 ESC×2 会打断开局（units_seen 恒 0，[9]④）。
    """
    focused = focus_game(hwnd)
    print(f"  [nav] 焦点获取: {'OK' if focused else 'FAIL（点击可能无效）'}")
    if allow_esc and not _ESC_LOCKED:
        press_key(0x1B); time.sleep(1.2)      # ESC 跳过 logo/过场
        press_key(0x1B); time.sleep(2.0)
    else:
        print("  [nav] ESC 已禁用（进对局确认前 / allow_esc=False），跳过 logo ESC")
        time.sleep(1.0)
    grab(hwnd, shots / f"{tag}_s1_menu.png")
    waits = {"mainmenu": 2.5, "skirmish": 9.0, "start": 6.0}
    # 每步点击后期望到达的目标画面（与原 NAV_STEPS 三步一一对应）
    expect = {"mainmenu": "sp_submenu", "skirmish": "skirmish_setup", "start": "battle"}
    for i, (name, x, y) in enumerate(NAV_STEPS):
        done = False
        for attempt in range(6):
            if not focus_game(hwnd):
                print(f"  [nav] {name} 前焦点丢失，重试获取")
            send_click(hwnd, x, y)
            time.sleep(waits[name])
            cur = grab(hwnd, shots / f"{tag}_nav_{i}_{name}_a{attempt}.png")
            v = verify_screen(hwnd, expect[name])
            print(f"  [nav] {name} 第{attempt + 1}次 语义校验 {'PASS' if v['ok'] else 'FAIL'} "
                  f"({v['reason']})")
            if v["ok"]:
                done = True
                break
        if not done:
            print(f"  [nav] {name} 6 次点击均未到达「{expect[name]}」（留档 "
                  f"{tag}_nav_{i}_{name}_final.png）")
            grab(hwnd, shots / f"{tag}_nav_{i}_{name}_final.png")
        if ss is not None:
            ss.step(hwnd, shots / f"{tag}_nav_{i}_{name}_step.png")


def enter_battle(pid: int, hwnd: int, proc: int, *, expect_units: int | None,
                 shots: Path, tag: str, manual_timeout: float = 100.0) -> tuple[bool, int]:
    """对局检测 +（可选）兵力校验。失败时给人工兜底窗口。

    ★ZC-11 closeout 缺陷修复（[9]④ / RESULT 勘误）：
      旧实现在首次 check 失败后无条件 try_auto_nav，而 try_auto_nav 开头 ESC×2
      会在**地图加载中**打断开局（对局永不建立，units_seen 恒 0）。
      新行为：
        ① 进入本函数即 set_esc_locked(True)（进对局确认前禁用 ESC）；
        ② 加载期判定改「帧推进 + 战术区色数」双校验（wait_battle_ready）；
        ③ 已在对局但兵力门禁不过时**只提示、不再兜底导航**（避免 ESC/点击打断）；
           官方门禁与 H1 实测 713 不兼容（>320 上限）——提示见 ZC-11 [9]⑤，不改 H1。
        ④ 仅当「确实不在对局」时才 ESC-free 兜底导航（allow_esc=False）。
    """
    mon = BattleMonitor(proc)
    prev_lock = set_esc_locked(True)

    def in_battle() -> bool:
        return wait_battle_ready(mon, hwnd, timeout=5.0)

    def check() -> bool:
        if not in_battle():
            return False
        cnt = mon.mobile_count()
        if expect_units is None:
            return True
        return expect_units * 0.5 <= cnt <= expect_units * 1.6

    try:
        if try_wait(check, 20):
            return True, mon.mobile_count()

        # 已进对局但兵力不符：只提示，禁止再导航（旧路径会 ESC 打断开局）
        if in_battle():
            cnt = mon.mobile_count()
            lo = (expect_units or 0) * 0.5
            hi = (expect_units or 0) * 1.6
            print(f"  [units] 已在对局但 units_seen={cnt} 不在门禁 [{lo:.0f},{hi:.0f}]"
                  f"（H1 图与官方兵力门禁不兼容，见 ZC-11 [9]⑤；不重导航、不按 ESC）")
            return False, cnt

        print(f"  [自动导航未确认] ESC-free 兜底导航 + 人工兜底 {manual_timeout:.0f}s："
              f"请在游戏窗口中完成 单人游戏→遭遇战→选择 {expect_units or ''} 地图→开始")
        try_auto_nav(hwnd, shots, tag + "_auto", allow_esc=False)  # 再自动试一轮（禁 ESC）
        if try_wait(check, manual_timeout):
            return True, mon.mobile_count()
        if in_battle():
            cnt = mon.mobile_count()
            print(f"  [units] 兜底后已在对局但 units_seen={cnt} 未过门禁（不重导航）")
            return False, cnt
        return False, 0
    finally:
        set_esc_locked(prev_lock)


def try_wait(fn, timeout: float) -> bool:
    t_end = time.time() + timeout
    while time.time() < t_end:
        try:
            if fn():
                return True
        except Exception:
            pass
        time.sleep(1.0)
    return False


def tail_log(game_dir: Path, dest: Path, n_lines: int = 200):
    log = game_dir / "ra2render.log"
    if log.is_file():
        lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
        dest.write_text("\n".join(lines[-n_lines:]), encoding="utf-8")


def parse_telemetry(game_dir: Path) -> list[str]:
    """从 ra2render.log 提取最近一条 2 秒遥测行。"""
    log = game_dir / "ra2render.log"
    if not log.is_file():
        return []
    lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
    return [l for l in lines if "ra2render-telemetry" in l][-3:]


