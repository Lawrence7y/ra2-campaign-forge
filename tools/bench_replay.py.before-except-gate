        f"{c['1pct_low_delta']:+.2f} ({c['1pct_low_gain_pct']}%) | "
        f"{'≥+15% 达标' if g['low1_gain_ge_15pct'] else '未达 +15%'} |",
        f"| TickMiss 次数 | {c['tick_miss_a']} 次 | {c['tick_miss_b']} 次 | {c['tick_miss_delta']:+d} | 卡顿改善需配对检验 |",
        f"| 渲染工作占比 (Render%) | {c['render_busy_pct_a']}% | {c['render_busy_pct_b']}% | "
        f"{(c['render_busy_pct_b'] or 0) - (c['render_busy_pct_a'] or 0):+.2f}% | Blit 吞吐代理 |",
        f"| render 占 gamemd 比例 | {c['render_of_gamemd_pct_a']}% | {c['render_of_gamemd_pct_b']}% | - | Blit 工作量占比 |",
        f"| 单核 CPU 占用 | {c['cpu_a']}% | {c['cpu_b']}% | - | 算力分配 |",
        f"| 有效样本占比 (valid_pct) | {c['valid_pct_a']}% | {c['valid_pct_b']}% | - | "
        f"{'两轮均 ≥10%（样本可信）' if g['both_valid_pct_ge_10'] else '⚠ 存在 <10% 轮次：该轮不得用于任何结论'} |",
        "",
        f"- 机器可读：`{json_name}`　人读：`{md_name}`",
        "- **【非证据】** 本表在**没有真机 A/B** 的情况下不代表任何性能收益：只有两轮各自通过",
        "  「对局内校验（CurrentFrame 推进 ≥3fps 且 单位数 ∈ [0.5,1.6]×期望）」且 valid_pct ≥ 10% 时，差值才可引用。",
        "",
    ]
    return "\n".join(md)



def ab_selftest() -> int:
    """Q4 **离线**自检：证明 A/B 联动的关键机制无需真机即可验证。

    ① INI 切换的零污染保证：在 out/ 下的**副本**上做 备份→改键→还原→逐字节校验
       （含「副本被改成非 UTF-8 编码」这条回归，覆盖旧实现的静默破坏路径）；
    ② 对比报告可复算性：用合成记录跑 ab_build_report，校验差值算术与门禁表达式；
    ③ 帧统计口径：合成帧序列校验 FPS / 1% low / TickMiss。
    全程不启动游戏、不触碰 ra2youli/。
    """
    base = AB_SELFTEST_DIR / "ini_selftest"
    base.mkdir(parents=True, exist_ok=True)
    print("=== Q4 A/B 联动离线自检（不启动游戏、不触碰 ra2youli/） ===")
    src = GAME_DIR / "ra2render.ini"
    if not src.is_file():
        print("  [FAIL] 读不到 ra2youli/ra2render.ini")
        return 1
    orig = src.read_bytes()
    orig_sha = hashlib.sha256(orig).hexdigest()

    for name in ("utf8_copy", "non_utf8_copy"):
        p = base / f"ra2render_{name}.ini"
        if name == "utf8_copy":
            p.write_bytes(orig)
        else:
            # 模拟「被外部编辑器另存为 ANSI/GBK」：UTF-8 正文后追加 GBK 字节（对 UTF-8 非法）
            gbk = "；中文注释回归样本".encode("gbk")
            p.write_bytes(orig + b"\r\n" + gbk + b"\r\n")
        before = p.read_bytes()
        read_render_ini(p)
        bk = set_render_ini({"EnableSIMD": False}, p)
        mid = p.read_bytes()
        assert mid != before, name + ": 改键后字节未变化"
        assert "EnableSIMD=0" in mid.decode("latin-1"), name + ": 未写入 0"
        rep = restore_render_ini(bk)
        assert rep["restored_byte_identical"] and p.read_bytes() == before, name + ": 还原不等"
        try:
            before.decode("utf-8")
            flag = "否"
        except UnicodeDecodeError:
            flag = "是"
        print(f"  [PASS] {name:15s} bytes={len(before):5d} 非UTF8={flag} "
              f"改键→还原 sha256={rep['sha256_after_restore'][:16]} 逐字节一致")
    assert src.read_bytes() == orig and hashlib.sha256(src.read_bytes()).hexdigest() == orig_sha
    print(f"  [PASS] ra2youli/ra2render.ini 全程未被触碰（sha256={orig_sha[:16]}）")

