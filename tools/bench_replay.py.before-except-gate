def classify(eip: int, modules: list) -> tuple[str, str]:
    mod = None
    for name, base, size in modules:
        if base <= eip < base + max(size, 0x1000):
            mod = name
            break
    if mod is None:
        return "unmapped", "(unmapped)"
    low = mod.lower()
    if low.startswith("gamemd"):
        for tag, lo, hi in GAMEMD_RANGES:
            if lo <= eip < hi:
                return tag, mod
        return "game_other", mod
    if low.startswith("ra2render"):
        return "render.hooks", mod
    if low in WAIT_MODULES:
        return "wait", mod
    if low in SHIM_MODULES:
        return "shim", mod
    if any(low.startswith(g) for g in GPU_MODULES):
        return "gpu.present", mod
    if low in ("user32.dll", "gdi32.dll", "uxtheme.dll"):
        return "win32.gdi", mod
    return "sys.other", mod


# ---------------- ra2render.ini 键切换（轨道 A 所有；备份→写→还原） ---------
#
# 编码纪律（Q1H-R3 收口）：ra2render.ini 是**游戏目录内的既有文件**，编码可能被外部
# 编辑器改成 ANSI/GBK（同目录 ddraw.ini 就不是 UTF-8）。旧的
# read_text(encoding="utf-8", errors="replace") 遇到非法 UTF-8 时会**静默替换成
# U+FFFD**，回写即造成不可逆内容破坏，且旧 restore 没有任何校验。
# 现改为字节透明（latin-1 对 0..255 是双射）读写，并在还原后**逐字节断言**；
# 任何不等都抛异常，不静默继续。键不唯一时拒绝盲改（交人工裁决）。

_BYTE_TRANSPARENT = "latin-1"   # 字节透明编解码


def _ini_path(path: "Path | None" = None) -> Path:
    return Path(path) if path is not None else (GAME_DIR / "ra2render.ini")


@dataclass
class RenderIniBackup:
    path: Path
    data: bytes

    @property
    def sha256(self) -> str:
        return hashlib.sha256(self.data).hexdigest()


def read_render_ini(path: "Path | None" = None) -> dict:
    t = _ini_path(path).read_bytes().decode(_BYTE_TRANSPARENT)
    vals = {}
    for k in V160_KEYS:
        m = re.search(rf"(?m)^{k}=(\d)", t)
        vals[k] = bool(int(m.group(1))) if m else True
    return vals


def set_render_ini(keys: dict[str, bool], path: "Path | None" = None) -> RenderIniBackup:
    p = _ini_path(path)
    bk = RenderIniBackup(p, p.read_bytes())
    t = bk.data.decode(_BYTE_TRANSPARENT)
    for k, v in keys.items():
        val = "1" if v else "0"
        hits = len(re.findall(rf"(?m)^{k}=", t))
        if hits > 1:
            raise RuntimeError(
                f"[FAIL] ra2render.ini 中 {k} 出现 {hits} 次（键不唯一），拒绝盲改——请人工裁决后再跑")
        if hits == 1:
            t = re.sub(rf"(?m)^({k}=)\d", rf"\g<1>{val}", t, count=1)
        else:
            t = t.rstrip("\r\n") + f"\r\n; bench_replay 矩阵写入\r\n{k}={val}\r\n"
    p.write_bytes(t.encode(_BYTE_TRANSPARENT))
    return bk


def restore_render_ini(bk: RenderIniBackup) -> dict:
    """还原并**逐字节校验**；返回校验报告（可落 JSON，不允许只靠 print 自证）。"""
    bk.path.write_bytes(bk.data)
    now = bk.path.read_bytes()
    rep = {
        "path": str(bk.path),
        "bytes": len(bk.data),
        "sha256_before": hashlib.sha256(bk.data).hexdigest(),
        "sha256_after_restore": hashlib.sha256(now).hexdigest(),
        "restored_byte_identical": now == bk.data,
    }
    if not rep["restored_byte_identical"]:
        raise RuntimeError(f"[FATAL] ra2render.ini 还原失败（字节不一致）：{rep}（禁止继续，人工处理）")
    return rep


