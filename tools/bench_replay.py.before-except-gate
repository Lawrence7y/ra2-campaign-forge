def probe_busy_thread(pid: int, tids: list[int], gm_range: tuple[int, int], rounds: int = 30,
                      *, gap_s: float = 0.01) -> dict:
    """选最忙线程（EIP 落在 gamemd 镜像内次数最多者），并返回探针明细。

    修复历史缺陷（ra2re/perf.py:375-382 同款）：旧实现的多轮探针之间**没有间隔**，
    实际读的是同一瞬间的同一批线程；一旦此刻所有线程都在内核等待，就静默回退到
    tids[0]（通常是加载器/音频线程），后续几万个样本全落 ntdll —— 这就是 98% idle 假基线。
    现在：① 每轮之间 sleep(gap_s) 让探针覆盖时间窗；② 全部零命中就**抛错拒绝采样**，
    绝不静默换线程；③ 返回探针明细供 JSON 留痕（选线合理性可复查）。
    """
    lo, hi = gm_range
    score = {t: 0 for t in tids}
    for _ in range(max(1, rounds)):
        for t in tids:
            e = read_eip(t)
            if e and lo <= e < hi:
                score[t] += 1
        time.sleep(max(0.0, gap_s))
    if not any(score.values()):
        raise RuntimeError(
            f"探针失败：{rounds} 轮 x {len(tids)} 线程（间隔 {gap_s * 1000:.0f}ms）内，没有任何线程的 "
            "EIP 落在 gamemd 镜像内。进程可能未进入对局或已被挂起。本工具拒绝在这种情况下采样，"
            "否则产出的就是又一份 98% idle 的无效基线。")
    best = max(score, key=lambda t: score[t])
    return {"tid": best, "score": score[best], "rounds": rounds, "gap_s": gap_s,
            "probed_threads": len(tids), "scores": score}


def sample_window(pid: int, proc: int, seconds: float, hz: float, *, require_match: bool = True) -> dict:
    tids = list_threads(pid)
    modules = list_modules(pid)
    gm = next(m for m in modules if m[0].lower().startswith("gamemd"))
    probe = probe_busy_thread(pid, tids, (gm[1], gm[1] + gm[2]))
    tid = probe["tid"]
    if require_match:
        # 采样前对局内校验（fail-fast）：CurrentFrame 不推进就直接放弃本窗口——
        # 宁可少一次采样，也不产出可被误引用的菜单样本。
        pre = BattleMonitor(proc)
        pre_stop = threading.Event()
        pt = threading.Thread(target=pre.poll_frames, args=(2.0, 50.0, pre_stop), daemon=True)
        pt.start()
        time.sleep(2.2)
        pre_stop.set()
        pt.join(timeout=1)
        pre_fs = frame_stats(pre.samples, 2.0)
        if pre_fs.get("fps_avg", 0.0) < 3.0:
            raise RuntimeError(
                f"对局内校验失败：2s 内 CurrentFrame 推进 {pre_fs.get('logic_frames')} 帧 "
                f"(fps_avg={pre_fs.get('fps_avg')}) < 3fps：未进入对局 / 已暂停 / 停在主菜单。"
                "拒绝采样（若刻意采菜单做负样本，请显式 require_match=False）。")

    stop = threading.Event()
    mon = BattleMonitor(proc)
    ft = threading.Thread(target=mon.poll_frames, args=(seconds, 100.0, stop), daemon=True)
    cpu0 = process_cpu(proc)
    t0 = time.perf_counter()
    ft.start()

    by_bucket: dict[str, int] = {}
    by_module: dict[str, int] = {}
    n = 0
    t_end = time.perf_counter() + seconds
    nxt = time.perf_counter()
    interval = 1.0 / hz
    while time.perf_counter() < t_end:
        e = read_eip(tid)
        n += 1
        if e:
            bucket, mod = classify(e, modules)
            by_bucket[bucket] = by_bucket.get(bucket, 0) + 1
            by_module[mod] = by_module.get(mod, 0) + 1
        nxt += interval
        d = nxt - time.perf_counter()
        if d > 0:
            time.sleep(d)
        else:
            nxt = time.perf_counter()
    span = time.perf_counter() - t0
    stop.set()
    ft.join(timeout=2)
    cpu1 = process_cpu(proc)

    wait_n = by_bucket.get("wait", 0)
    shim_n = by_bucket.get("shim", 0)
    sys_gui_n = by_bucket.get("win32.gdi", 0)
    gpu_n = by_bucket.get("gpu.present", 0)
    sys_other_n = by_bucket.get("sys.other", 0)
    unmapped_n = by_bucket.get("unmapped", 0)
    noise_n = wait_n + shim_n + sys_gui_n + gpu_n + sys_other_n + unmapped_n

    gamemd_n = sum(v for k, v in by_bucket.items() if not k.startswith("render.hooks") and k not in ("wait", "shim", "win32.gdi", "gpu.present", "sys.other", "unmapped"))
    hooks_n = by_bucket.get("render.hooks", 0)
    valid_n = gamemd_n + hooks_n

    render_n = sum(v for k, v in by_bucket.items() if k.startswith("render") and k != "render.hooks")
    logic_n = sum(v for k, v in by_bucket.items() if k.startswith("logic"))
    coverage_n = sum(v for k, v in by_bucket.items() if k != "game_other" and not k.startswith("render.hooks") and k not in ("wait", "shim", "win32.gdi", "gpu.present", "sys.other", "unmapped"))
    coverage_pct = round(100.0 * coverage_n / max(gamemd_n, 1), 2) if gamemd_n > 0 else 0.0

    cpu = None
    if cpu0 and cpu1:
        cpu = round((cpu1[0] - cpu0[0]) + (cpu1[1] - cpu0[1]), 3)
    return {
        "tid": tid,
        "tid_probe": {"score": probe["score"], "rounds": probe["rounds"],
                      "gap_s": probe["gap_s"], "probed_threads": probe["probed_threads"],
                      "all_scores": probe["scores"]},
        "samples": n,
        "hz_actual": round(n / span, 1),
        "span_s": round(span, 2),
        "by_bucket": by_bucket,
        "by_module": by_module,
        "noise_samples": noise_n,
        "noise_pct": round(100.0 * noise_n / max(n, 1), 2),
        "valid_samples": valid_n,
        "valid_pct": round(100.0 * valid_n / max(n, 1), 2),
        "gamemd_samples": gamemd_n,
        "valid_gamemd_pct": round(100.0 * gamemd_n / max(n, 1), 2),
        "busy_pct": round(100.0 * valid_n / max(n, 1), 2),
        "wait_pct": round(100.0 * wait_n / max(n, 1), 2),
        "shim_pct": round(100.0 * shim_n / max(n, 1), 2),
        "render_busy_pct": round(100.0 * render_n / max(n, 1), 2),
        "logic_busy_pct": round(100.0 * logic_n / max(n, 1), 2),
        "render_of_gamemd_pct": round(100.0 * render_n / max(gamemd_n, 1), 2) if gamemd_n > 0 else 0.0,
        "logic_of_gamemd_pct": round(100.0 * logic_n / max(gamemd_n, 1), 2) if gamemd_n > 0 else 0.0,
        "coverage_pct": coverage_pct,
        "cpu_seconds": cpu,
        "cpu_pct_of_one_core": round(100.0 * cpu / span, 2) if cpu is not None else None,
        "frames": frame_stats(mon.samples, span),
    }


